{
  "name": "lemma-language",
  "displayName": "Lemma Language",
  "description": "Language support for Lemma: syntax highlighting, inline diagnostics, and clickable Registry references",
  "version": "0.9.10",
  "publisher": "lemma",
  "license": "Apache-2.0",
  "icon": "lemma_128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemma/lemma"
  },
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lemma",
        "aliases": [
          "Lemma",
          "lemma"
        ],
        "extensions": [
          ".lemma"
        ],
        "filenames": [
          "lemma.std"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lemma",
        "scopeName": "source.lemma",
        "path": "./syntaxes/lemma.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "controlKeyword",
        "superType": "keyword",
        "description": "Control flow keywords (unless, then, not, and, in, type, veto, now, past, future, stray repo)"
      },
      {
        "id": "dataBody",
        "superType": "type",
        "description": "Data or with field body after the colon (type, value, constraints)"
      },
      {
        "id": "punctuation",
        "superType": "operator",
        "description": "Declaration colons separating field/rule names from their bodies"
      },
      {
        "id": "reference",
        "superType": "variable",
        "description": "Identifiers referenced in rule and spec bodies"
      },
      {
        "id": "declarationKeyword",
        "superType": "keyword",
        "description": "Declaration keywords (spec, data, with, rule, repo, uses, meta)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lemma",
        "scopes": {
          "namespace": ["keyword.other.namespace.lemma"],
          "class": ["storage.type.class.lemma"],
          "property": ["entity.name.tag.lemma"],
          "function": ["entity.name.function.preprocessor.lemma"],
          "string": ["string.quoted.double.lemma"],
          "comment": ["comment.block.lemma"],
          "keyword": ["storage.modifier.lemma"],
          "operator": ["keyword.operator.lemma"],
          "controlKeyword": ["keyword.control.lemma"],
          "dataBody": ["string.unquoted.lemma"],
          "punctuation": ["punctuation.definition.tag.lemma"],
          "reference": ["support.type.property-name.lemma"],
          "declarationKeyword": ["keyword.declaration.lemma"]
        }
      }
    ],
    "configuration": {
      "title": "Lemma",
      "properties": {
        "lemma.lspServerPath": {
          "type": "string",
          "default": "lemma",
          "description": "Path to the lemma binary. If not absolute, the binary is looked up on $PATH."
        }
      }
    },
    "configurationDefaults": {
      "[lemma]": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.defaultFormatter": "lemma.lemma-language",
        "editor.semanticTokenColorCustomizations": {
          "rules": {
            "namespace":          "#BD8EBB",
            "class":              "#5DBDAA",
            "property":           "#A3B5DF",
            "function":           "#A3B5DF",
            "string":             "#D07868",
            "comment":            "#595945",
            "keyword":            "#6BA0C2",
            "operator":           "#80807A",
            "controlKeyword":     "#726B83",
            "dataBody":           "#D07868",
            "punctuation":        "#79987F",
            "reference":          "#A59582",
            "declarationKeyword": "#80807A"
          }
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run compile",
    "precommit": "npm ci && npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.25.0",
    "ovsx": "1.0.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2",
    "keytar": "npm:noop2@2.0.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.25.12": true
  }
}
