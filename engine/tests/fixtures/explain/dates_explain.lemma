spec date_handling
"""
Explain fixture from cli/tests/integrations/examples/05_date_handling.lemma.
Adds membership_active: now in start...(start + length).
"""

uses lemma units

data contract_end:        2024-12-31
data contract_start:      2024-01-15
data employee_birth_date: 1990-05-20
data hire_date:           2024-03-01
data meeting_duration:    1.5 hour
data meeting_time:        14:30:00
data probation_period:    90 day
data project_deadline:    2024-10-01T17:00:00Z
data current_date:        date
data membership_start:    date
data membership_length:   units.calendar

rule contract_duration:
  contract_start...contract_end as day as number

rule probation_end_date:
  hire_date + probation_period

rule is_probation_complete:
  current_date > probation_end_date

rule employee_age:
  employee_birth_date...current_date as year as number

rule is_adult:
  employee_age >= 18

rule days_until_deadline:
  current_date...project_deadline as day

rule is_overdue:
  days_until_deadline < 0 day

rule is_urgent:
  days_until_deadline < 7 day and not is_overdue

rule meeting_end_time:
  meeting_time + meeting_duration

rule contract_active:
  current_date >= contract_start
  and current_date <= contract_end
  unless is_overdue then false

rule time_employed:
  hire_date...current_date

rule years_employed:
  time_employed as year as number

rule membership_active:
  now in membership_start...(membership_start + membership_length)
