{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lemma",
      "camelcase": "Lemma",
      "scope": "source.lemma",
      "path": ".",
      "file-types": ["lemma"],
      "highlights": "../../languages/lemma/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.11.4",
    "license": "Apache-2.0",
    "description": "Lexical tree-sitter grammar for Lemma",
    "links": {
      "repository": "https://github.com/lemma/lemma"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
